{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "out",
    "module": "commonjs",
    "target": "ES2022",
    "types": ["node", "vscode"],
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
